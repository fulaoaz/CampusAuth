{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CampusAuth",
  "version": "0.3.0",
  "identifier": "cc.fulao.campusauth",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" },
    "devUrl": "http://127.0.0.1:5179",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CampusAuth 校园网认证",
        "width": 1240,
        "height": 850,
        "minWidth": 980,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#f5f7fa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:5179 http://127.0.0.1:5179; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "publisher": "fulao",
    "shortDescription": "校园网自动认证与断线重连",
    "longDescription": "CampusAuth 校园网认证应用：本机账号管理、校园网认证、断线重连、可选电源计划与诊断。全部中文界面，核心直接运行在应用中。",
    "copyright": "Copyright 2026 CampusAuth contributors. MIT license.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/fulaoaz/CampusAuth",
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../assets/NotoSansSC-OFL.txt": "NotoSansSC-OFL.txt"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "CampusAuth",
        "installerHooks": "installer/hooks.nsh",
        "customLanguageFiles": { "SimpChinese": "installer/SimpChinese.nsh" },
        "compression": "lzma"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "libgtk-3-0"],
        "section": "net",
        "priority": "optional"
      },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
